# Copiar a .env y ajustar

JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_MIN=1440

MONGO_LOCAL_URI=mongodb://localhost:27017
MONGO_LOCAL_DB=inguard_local
# MONGO_CLOUD_URI=mongodb+srv://usuario:clave@cluster.mongodb.net
# MONGO_CLOUD_DB=inguard_cloud

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
LOGIN_BLOQUEO_MIN=15

SYNC_AUTOMATICA=true
SYNC_INTERVALO_SEG=30
